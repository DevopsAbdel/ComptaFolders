<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Createur de dossiers clients comptables"
        Height="420" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E0E"
        Foreground="#E6E6E6"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#7856FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9B7CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6A4FE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A42"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#2F2F3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#9B7CFF"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#7C7C86"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2,4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B9A8FF"/>
                                <Setter TargetName="Border" Property="Background" Value="#383843"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9B9BA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="#1E1E1E" BorderBrush="#7856FF" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="#9B7CFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#2A1F4D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#9B7CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Label Content="Année" Foreground="#E6E6E6" Margin="0,0,0,4" Padding="0"/>
                <TextBox Name="YearBox" Text="2026" Height="28" Background="#1E1E1E" Foreground="#E6E6E6" BorderBrush="#3A3A42" Padding="6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Label Content="Société (séparer par ; ou , pour création multiple)" Foreground="#E6E6E6" Margin="0,0,0,4" Padding="0"/>
                <TextBox Name="CompanyBox" Height="28" Background="#1E1E1E" Foreground="#E6E6E6" BorderBrush="#3A3A42" Padding="6"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Label Content="Chemin parent" Foreground="#E6E6E6" Margin="0,0,0,4" Padding="0"/>
            <TextBox Name="ParentBox" Height="28" Background="#1E1E1E" Foreground="#E6E6E6" BorderBrush="#3A3A42" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,4,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Name="BrowseBtn" Content="📂 Parcourir" Padding="8,4" Margin="0,0,6,0" Height="26" Background="#7856FF" Foreground="White" FontSize="11"/>
                <Button Name="CreateBtn" Content="✅ Créer le dossier" Padding="8,4" Height="26" Background="#22C55E" Foreground="White" FontSize="11"/>
            </StackPanel>
            <CheckBox Name="OpenAfterCreate" Content="Ouvrir le dossier après création" IsChecked="True" Foreground="#E6E6E6" Margin="0,6,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox Grid.Row="3" Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#16161D" Foreground="#C9C9D0" BorderBrush="#2A2A30" Margin="0,0,0,8" Padding="8"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="GuideBtn" Content="📖 Guide" Margin="4,0" Padding="12,6" Background="#5B9BFF" Foreground="White"/>
            <Button Name="IndexBtn" Content="📑 Index documents" Margin="4,0" Padding="12,6" Background="#F5B700" Foreground="#1E1E1E"/>
        </StackPanel>
    </Grid>
</Window>